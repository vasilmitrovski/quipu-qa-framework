{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@config": ["./config/index.ts"],
      "@config/*": ["./config/*"],
      "@core/*": ["./src/core/*"],
      "@api/*": ["./src/api/*"],
      "@web/*": ["./src/web/*"]
    },
    "types": ["node"]
  },
  "include": ["config", "src", "tests", "playwright.config.ts"]
}
