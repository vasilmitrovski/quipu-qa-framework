{
  "name": "quipu-qa-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-region Playwright + TypeScript test framework (API + Web) for ParaBank",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:web": "playwright test --project=web-chromium --project=web-firefox",
    "test:web:chromium": "playwright test --project=web-chromium",
    "test:smoke": "playwright test --grep @smoke --project=api --project=web-chromium",
    "report": "node scripts/show-report.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "parabank:up": "docker run -d --rm --name parabank -p 8080:8080 parasoft/parabank && npm run -s parabank:wait",
    "parabank:wait": "node .github/scripts/wait-for-parabank.mjs",
    "parabank:down": "docker stop parabank"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.7.5",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
